{
  "headers": [
    {"source": "/data.(.*).json", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/flags/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=604800"}]},
    {"source": "/(og.png|icon.svg|icon-512.png|apple-touch-icon.png)", "headers": [{"key": "Cache-Control", "value": "public, max-age=86400"}]}
  ]
}
